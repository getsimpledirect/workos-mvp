# ═══════════════════════════════════════════════════════════════════════════════
# Ghost Narrator - Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Server Configuration ──────────────────────────────────────────────────────
# External IP address of your VM (used for webhook URLs)
SERVER_EXTERNAL_IP=your-vm-external-ip

# Timezone for n8n (IANA format)
TIMEZONE=UTC

# ─── n8n Configuration ─────────────────────────────────────────────────────────
# Admin credentials for n8n web interface
N8N_USER=admin
N8N_PASSWORD=your-secure-password-here

# Encryption key for n8n (generate with: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=your-encryption-key-here

# ─── vLLM Configuration ────────────────────────────────────────────────────────
# URL to your vLLM API endpoint
# Use host.docker.internal to access services on the host machine
VLLM_BASE_URL=http://host.docker.internal:8000

# Model name as registered in vLLM
VLLM_MODEL_NAME=Qwen/Qwen3-14B

# ─── TTS Service Configuration ─────────────────────────────────────────────────
# Device for TTS inference: cpu or cuda
TTS_DEVICE=cpu

# Number of worker threads for parallel processing
MAX_WORKERS=1

# ─── Google Cloud Storage ──────────────────────────────────────────────────────
# GCS bucket for storing generated audio files
# Leave empty to disable GCS uploads (audio will only be stored locally)
GCS_BUCKET_NAME=your-gcs-bucket-name

# Prefix path within the bucket (no leading/trailing slashes)
GCS_AUDIO_PREFIX=audio/articles

# ─── Redis Configuration ───────────────────────────────────────────────────────
# Job TTL in seconds (default: 86400 = 24 hours)
REDIS_JOB_TTL=86400

# ═══════════════════════════════════════════════════════════════════════════════
# NOTES
# ═══════════════════════════════════════════════════════════════════════════════
#
# Ghost API Keys:
#   Ghost Content API keys are configured in n8n as Variables (not here).
#   After starting n8n, go to Settings → Variables and add:
#     - GHOST_KEY_SITE1: Your first Ghost site's Content API key
#     - GHOST_KEY_SITE2: Your second Ghost site's Content API key
#     - GHOST_SITE1_ADMIN_API_KEY: Your first Ghost site's Admin API key (for embedding audio)
#     - GHOST_SITE2_ADMIN_API_KEY: Your second Ghost site's Admin API key (for embedding audio)
#
# Voice Sample:
#   Place your voice reference file at:
#     tts-service/voices/reference.wav
#   This should be a 30-60 second WAV file of clear speech.
#
# GCS Authentication:
#   The TTS service uses Application Default Credentials (ADC).
#   On GCE VMs, attach a service account with Storage Object Admin role.
#   Locally, run: gcloud auth application-default login
#
# ═══════════════════════════════════════════════════════════════════════════════
